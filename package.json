{
  "name": "chess-review",
  "version": "0.1.7",
  "description": "Sync chess games from Lichess, chess.com and PGN files into one reviewable note per game, with an interactive board and offline Stockfish analysis.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint src tests --ext .ts",
    "test": "vitest run",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethemgur/chess-journal.git"
  },
  "keywords": [
    "obsidian",
    "chess",
    "pgn",
    "lichess",
    "stockfish"
  ],
  "author": "Ethem",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "chessground": "^9.2.1",
    "chessops": "^0.15.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "obsidian": "^1.14.4",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
